{
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "wait",
        "retrieve",
        "suppress"
      ],
      "title": "Action",
      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "trigger": {
      "anyOf": [
        {
          "enum": [
            "provisional",
            "multi_intent",
            "final"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set when action == 'retrieve'.",
      "title": "Trigger"
    },
    "ts": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Stream time of the decision (s).",
      "title": "Ts"
    },
    "stability_score": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stability Score"
    }
  },
  "required": [
    "action",
    "reason"
  ],
  "title": "ControllerDecision",
  "type": "object"
}
